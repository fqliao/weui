{
  "name": "ui-agent-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsx scripts/dev.ts --production",
    "dev:web": "next dev apps/web --port 3100",
    "dev:api": "tsx apps/api/src/index.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "dev:sample": "tsx apps/sample/src/index.ts",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\"",
    "build": "pnpm typecheck && next build apps/web",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts",
    "verify": "tsx scripts/verify.ts",
    "backup": "tsx scripts/backup.ts",
    "health": "tsx scripts/health.ts",
    "browser:check": "tsx scripts/check-browser.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@langchain/core": "1.2.11",
    "@langchain/openai": "1.5.13",
    "@midscene/web": "1.12.6",
    "@prisma/client": "6.19.3",
    "bullmq": "6.3.4",
    "deepagents": "1.13.4",
    "dotenv": "17.4.2",
    "fastify": "5.12.4",
    "fflate": "0.8.3",
    "ioredis": "6.0.0",
    "langchain": "1.5.11",
    "langsmith": "~0.9.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
