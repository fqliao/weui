{
  "id": "sample-knowledge-v1",
  "hash": "2e06516e7bca498d6e7e9c0ca587049e2170aa0dd69b1f5e55944ec0fef1c5c0",
  "content": {
    "pages": [
      {
        "id": "overview",
        "title": "审批领域总览",
        "body": "该知识包只适用于随 MVP 提供的独立审批样例系统。涉及申请、角色、租户、状态、规则、审计。真实系统接入时必须由业务负责人审核并发布自己的规则。",
        "source": "sample-approval-spec@1.0",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "flow",
        "title": "申请与审批流程",
        "body": "申请人创建草稿，提交后进入 PENDING；另一位 reviewer 可以通过或驳回。所有结论需查询持久化状态；提示文字只是辅助证据。",
        "source": "sample-approval-spec@1.0",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "roles",
        "title": "角色与权限",
        "body": "applicant 可创建和提交申请；reviewer 可审批他人申请。双方都受租户限制。自审批禁止。参考 R04、R06、R07、R09。",
        "source": "sample-approval-spec@1.0",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "boundaries",
        "title": "表单与金额边界",
        "body": "标题长度 1-200 字符，金额为 1-1000000 整数。空值、过长、零、负数、超限都应被拒绝。参考 R01、R02。",
        "source": "sample-approval-spec@1.0",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "idempotency",
        "title": "重复提交与未知结果",
        "body": "重复提交不重复转换状态或增加审计。写操作结果未知时先查询，不能自动重放。参考 R03、R08。",
        "source": "sample-approval-spec@1.0",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "evidence",
        "title": "证据与测试方法",
        "body": "用例必须绑定规则、断言、业务对象、首次失败证据。数据以 run_id 隔离并清理。证据不足为 INCONCLUSIVE，依赖缺失为 BLOCKED。参考 R10。",
        "source": "sample-approval-spec@1.0",
        "status": "SAMPLE_APPROVED"
      }
    ],
    "rules": [
      {
        "id": "R01",
        "title": "申请标题",
        "text": "标题去除首尾空格后长度为 1-200 个字符。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R02",
        "title": "金额范围",
        "text": "金额须为 1-1000000 的整数；零、负数与超限数值均拒绝。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R03",
        "title": "状态转换",
        "text": "草稿可提交为 PENDING；已提交申请重复提交不重复记账。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R04",
        "title": "审批条件",
        "text": "审批人须拥有 reviewer 角色；仅 PENDING 可审批，记录实际审批人。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R05",
        "title": "驳回条件",
        "text": "合法审批人可将 PENDING 改为 REJECTED 并记录审计。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R06",
        "title": "对象授权",
        "text": "操作前校验用户角色、租户和业务对象；请求失败不产生业务变更。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R07",
        "title": "禁止自审批",
        "text": "申请人不能审批自己的申请，即使其同时具备 reviewer 角色。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R08",
        "title": "提交幂等",
        "text": "同一申请提交只发生一次状态转换及一次 submit 审计。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R09",
        "title": "租户隔离",
        "text": "租户之间不可读取或修改对方申请。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      },
      {
        "id": "R10",
        "title": "证据与清理",
        "text": "不能仅凭成功提示判定通过；查询持久化结果并按 run_id 清理数据。",
        "source": "sample-approval-spec@1.0",
        "owner": "样例业务维护者",
        "status": "SAMPLE_APPROVED"
      }
    ],
