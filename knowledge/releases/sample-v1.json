    "cases": [
      {
        "id": "C01",
        "title": "合法申请保存为草稿",
        "category": "正常流程",
        "ruleIds": [
          "R01",
          "R02",
          "R10",
          "R03"
        ],
        "steps": [
          "申请人登录",
          "填写标题与金额 100",
          "保存申请",
          "查询持久化记录"
        ],
        "assertionIds": [
          "record.count",
          "record.status",
          "record.amount"
        ],
        "expected": "生成 1 条草稿，金额为 100"
      },
      {
        "id": "C02",
        "title": "提交后由另一人审批通过",
        "category": "正常流程",
        "ruleIds": [
          "R03",
          "R04",
          "R10"
        ],
        "steps": [
          "创建并提交申请",
          "切换审批人",
          "点击通过",
          "核对状态、审批人和审计事件"
        ],
        "assertionIds": [
          "record.count",
          "record.status",
          "record.reviewer",
          "audit.review"
        ],
        "expected": "状态 APPROVED，审批人为 reviewer，存在通过事件"
      },
      {
        "id": "C03",
        "title": "审批人驳回申请",
        "category": "正常流程",
        "ruleIds": [
          "R03",
          "R05",
          "R10",
          "R04"
        ],
        "steps": [
          "创建并提交申请",
          "切换审批人",
          "点击驳回",
          "核对持久化状态"
        ],
        "assertionIds": [
          "record.count",
          "record.status",
          "record.reviewer",
          "audit.review"
        ],
        "expected": "状态 REJECTED，记录审批人"
      },
      {
        "id": "C04",
        "title": "标题为空时拒绝保存",
        "category": "表单边界",
        "ruleIds": [
          "R01",
          "R10"
        ],
        "steps": [
          "标题留空",
          "填写合法金额",
          "保存",
          "核对错误提示和记录数量"
        ],
        "assertionIds": [
          "record.count",
          "ui.validation"
        ],
        "expected": "显示标题校验错误，不产生记录"
      },
      {
        "id": "C05",
        "title": "标题超过 200 字时拒绝保存",
        "category": "表单边界",
        "ruleIds": [
          "R01",
          "R10"
        ],
        "steps": [
          "填写 201 字标题",
          "保存",
          "核对校验与记录数量"
        ],
        "assertionIds": [
          "record.count",
          "ui.validation"
        ],
        "expected": "拒绝超长标题，不产生记录"
      },
      {
        "id": "C06",
        "title": "金额为零时拒绝保存",
        "category": "金额边界",
        "ruleIds": [
          "R02",
          "R10"
        ],
        "steps": [
          "填写金额 0",
          "保存",
          "核对校验与记录数量"
        ],
        "assertionIds": [
          "record.count",
          "ui.validation"
        ],
        "expected": "金额必须大于 0，不产生记录"
      },
      {
        "id": "C07",
        "title": "金额为负数时拒绝保存",
        "category": "金额边界",
        "ruleIds": [
          "R02",
          "R10"
        ],
        "steps": [
          "填写金额 -1",
          "保存",
          "核对校验与记录数量"
        ],
        "assertionIds": [
          "record.count",
          "ui.validation"
        ],
        "expected": "拒绝负金额，不产生记录"
      },
      {
        "id": "C08",
        "title": "金额超过上限时拒绝保存",
        "category": "金额边界",
        "ruleIds": [
          "R02",
          "R10"
        ],
        "steps": [
          "填写金额 1000001",
          "保存",
          "核对校验与记录数量"
        ],
        "assertionIds": [
          "record.count",
          "ui.validation"
        ],
        "expected": "金额不得超过 1000000，不产生记录"
      },
      {
        "id": "C09",
        "title": "普通申请人不能审批他人申请",
        "category": "角色权限",
        "ruleIds": [
          "R04",
          "R06",
          "R10"
        ],
        "steps": [
          "准备他人待审批申请",
          "普通申请人打开审批页",
          "尝试审批",
          "核对请求被拒绝且状态未变"
        ],
        "assertionIds": [
          "record.count",
          "record.status",
          "audit.noApprove",
          "ui.denied"
        ],
        "expected": "拒绝无审批角色用户，状态仍 PENDING"
      },
      {
        "id": "C10",
        "title": "审批角色也不能审批自己的申请",
        "category": "角色权限",
        "ruleIds": [
          "R04",
          "R07",
          "R10",
          "R06"
        ],
        "steps": [
          "以审批角色创建自己的申请",
          "提交后尝试自审批",
          "核对拒绝提示、状态与审计"
        ],
        "assertionIds": [
          "record.count",
          "record.status",
          "audit.noApprove",
          "ui.denied"
        ],
        "expected": "自审批被拒绝，状态仍 PENDING，无通过事件"
      },
      {
        "id": "C11",
        "title": "重复提交只产生一次状态变更",
        "category": "幂等性",
        "ruleIds": [
          "R03",
          "R08",
          "R10"
        ],
        "steps": [
          "创建申请",
          "连续两次点击提交",
          "查询提交计数和审计"
        ],
        "assertionIds": [
          "record.count",
          "record.status",
          "record.submitCount",
          "audit.submitCount"
        ],
        "expected": "状态 PENDING，submitCount 和 submit 审计均为 1"
      },
      {
        "id": "C12",
        "title": "跨租户访问不能读取或审批",
        "category": "租户隔离",
        "ruleIds": [
          "R06",
          "R09",
          "R10"
        ],
        "steps": [
          "准备租户 A 申请",
          "切换租户 B 用户访问",
          "尝试读取",
          "核对拒绝提示与原记录"
        ],
        "assertionIds": [
          "record.count",
          "record.status",
          "ui.denied",
          "audit.noApprove",
          "ui.noForeignRecord"
        ],
        "expected": "跨租户拒绝访问，原记录状态未变"
      }
    ],
