DATABASE_URL=postgresql://uiagent:CHANGE_ME@127.0.0.1:55432/uiagent
REDIS_URL=redis://127.0.0.1:56379
API_PORT=3101
WEB_PORT=3100
SAMPLE_PORT=3102
API_ORIGIN=http://127.0.0.1:3101
WEB_ORIGIN=http://localhost:3100
SAMPLE_ORIGIN=http://127.0.0.1:3102
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTES
SAMPLE_SERVICE_KEY=REPLACE_WITH_RANDOM_32_BYTES
BOOTSTRAP_ADMIN_EMAIL=admin@uiagent.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
BOOTSTRAP_TESTER_EMAIL=tester@uiagent.local
BOOTSTRAP_TESTER_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# catalog = explicit deterministic sample planning; deepagents = actual model planning
AGENT_MODE=catalog
# Browser choice is saved in website / run settings, default Chrome. Paths belong to the execution server.
# BROWSER_EXECUTABLE_PATH is a legacy Chrome-only fallback; Edge never uses it.
BROWSER_EXECUTABLE_PATH=
CHROME_EXECUTABLE_PATH=
EDGE_EXECUTABLE_PATH=
# Use the Playwright Firefox build (pnpm exec playwright install firefox), not stock Firefox.
FIREFOX_EXECUTABLE_PATH=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Read from LLM_API_KEY or the existing DEEPSEEK_API_KEY environment variable.
LLM_API_KEY=
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
LLM_MAX_TOKENS=4096
MODEL_TIMEOUT_MS=90000
WORKER_CONCURRENCY=2
RUN_TIMEOUT_MS=600000
RUN_MAX_ACTIONS=40
RUN_MAX_MODEL_CALLS=60
RUN_MAX_TOKENS=150000
RUN_MAX_COST_USD=1
RUN_MAX_COST_CNY=10
EVIDENCE_DIR=.runtime/evidence
COOKIE_SECURE=false
ALLOW_SAMPLE_ENVIRONMENT=true
EXECUTION_ENABLED=true
# Required for UI execution; DeepSeek may reuse the local DEEPSEEK_API_KEY.
MIDSCENE_MODEL_NAME=deepseek-flash
MIDSCENE_MODEL_BASE_URL=https://api.deepseek.com
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_FAMILY=deepseek
MIDSCENE_MODEL_EXTRA_BODY_JSON={"thinking":{"type":"disabled"}}
